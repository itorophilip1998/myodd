# Host development URLs. Compose supplies internal service addresses automatically.
# Production Hetzner checklist (manual server edits): see .env.production.example
DATABASE_URL=postgresql://myodd:myodd@localhost:5433/myodd
REDIS_URL=redis://localhost:6379
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000

# Clerk (also used via apps/web/.env.local for Compose web + api)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Python AI: odds baseline, or poisson after training a model artifact.
PREDICTION_MODEL=odds
PREDICTION_WORKERS=2
MODEL_PATH=./data/model.json

# Instruction parsing orchestrator (dynamic). Language models never pick bets.
# Providers: openai | groq | ollama | rules
# Dual models: accurate (AI_MODEL) + fast (AI_MODEL_FAST). Route: auto | fast | accurate.
AI_PROVIDER=openai
# Defaults work on most OpenAI projects. If your project has GPT-5.6 enabled, you can use:
# AI_MODEL=gpt-5.6-sol and AI_MODEL_FAST=gpt-5.6-terra
AI_MODEL=gpt-4o
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_ROUTE=auto
AI_MODEL_TEMPERATURE=0.2
# Canonical key for hosted providers. OPENAI_API_KEY is accepted as an alias for openai.
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional OpenAI-compatible override (defaults per provider).
AI_BASE_URL=
# Legacy local/rules fallback when AI_PROVIDER is unset.
INTENT_PROVIDER=rules
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

SPORTYBET_REGION=ng
SPORTYBET_API_BASE_URL=https://www.sportybet.com
SPORTYBET_TIMEOUT_MS=15000
SPORTYBET_MIN_INTERVAL_MS=250
SPORTYBET_MAX_CONCURRENCY=4
SPORTYBET_CACHE_TTL_MS=90000

# Public source used for background master-code discovery (comma-separated HTTPS URLs).
CODE_SOURCE_URLS=https://www.sportybet.com/ng/m/code-hub/codes
CODE_DISCOVERY_INTERVAL_HOURS=6
CODE_VALIDATION_INTERVAL_MINUTES=60
