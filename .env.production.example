# =============================================================================
# Production env checklist (Hetzner)
# =============================================================================
# Copy keys into these files on the server — never commit real values:
#   /opt/myodd/.env
#   /opt/myodd/apps/web/.env.local
#
# Auto-deploy (push to `production`) syncs code only. It does NOT overwrite
# these files. When you add a NEW env var in code/compose, add it here and
# manually set it on the server before (or right after) the next deploy.
# =============================================================================

# --- /opt/myodd/.env ---------------------------------------------------------

# Database (Compose overrides DATABASE_URL for containers; keep for host tools)
DATABASE_URL=postgresql://myodd:myodd@localhost:5433/myodd
REDIS_URL=redis://localhost:6379

# Public URLs — before domain: IP:3000. After Spaceship DNS + HTTPS:
#   DOMAIN=yourdomain.com
#   CORS_ORIGIN=https://yourdomain.com
#   CLERK_AUTHORIZED_PARTIES=https://yourdomain.com
#   PUBLIC_WEB_URL=https://yourdomain.com
#   ACME_EMAIL=you@yourdomain.com
API_PORT=3001
DOMAIN=myodd.org
ACME_EMAIL=admin@myodd.org
CORS_ORIGIN=https://myodd.org
CLERK_AUTHORIZED_PARTIES=https://myodd.org
PUBLIC_WEB_URL=https://myodd.org
GOOGLE_SITE_VERIFICATION=c315TbfKdqoaKm_ZCFVUj_UGicyj8QmWpGurIdRyVzM

# GA4 public build arguments. Create the stream first, disable Enhanced
# Measurement, then confirm manual events and rebuild the web image.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MANUAL_EVENTS_CONFIRMED=false

# Browser → API. Leave empty so Caddy same-origin /api is used (never expose :3001 publicly).
NEXT_PUBLIC_API_URL=

# Instruction parsing (never picks bets)
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_ROUTE=auto
AI_MODEL_TEMPERATURE=0.2
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_BASE_URL=
INTENT_PROVIDER=rules
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# AI service
PREDICTION_MODEL=odds
PREDICTION_WORKERS=2
AI_TIMEOUT_MS=120000
AI_SERVICE_URL=http://ai:8000

# SportyBet (public undocumented web API — no bookmaker login)
SPORTYBET_REGION=ng
SPORTYBET_API_BASE_URL=https://www.sportybet.com
SPORTYBET_TIMEOUT_MS=15000
SPORTYBET_MIN_INTERVAL_MS=250
SPORTYBET_MAX_CONCURRENCY=4
SPORTYBET_CACHE_TTL_MS=90000

# Independent match-progress fallback; configure as a server secret.
# Requires API-Football access to the saved matches/dates.
API_FOOTBALL_KEY=

# Public BBC Sport results scraper (no API key); set false to disable.
BBC_RESULTS_ENABLED=true

# Catalog discovery
CODE_SOURCE_URLS=https://www.sportybet.com/ng/m/code-hub/codes
CODE_DISCOVERY_INTERVAL_HOURS=6
CODE_VALIDATION_INTERVAL_MINUTES=60

# --- /opt/myodd/apps/web/.env.local (Clerk) ----------------------------------
# Use Clerk *production* keys for the public site when ready.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
