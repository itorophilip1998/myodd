generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VarianceLevel {
  LOWER
  MODERATE
  HIGHER
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SlipPlayStatus {
  OPEN
  LIVE
  CUT
  ALL_PLAYED
  UNKNOWN
}

enum LegPlayStatus {
  UPCOMING
  LIVE
  PLAYED
  CUT
  UNKNOWN
}

enum SettlementResult {
  WON
  LOST
  VOID
  PENDING
  UNKNOWN
}

model SlipGroup {
  completedAt DateTime? @map("completed_at")
  deleteAfter DateTime? @map("delete_after")
  lifecycleCheckedAt DateTime? @map("lifecycle_checked_at")
  deletedAt            DateTime?       @map("deleted_at")
  id                   String          @id @default(cuid())
  ownerId              String?         @map("owner_id")
  owner                AppUser?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  isPublic             Boolean         @default(false) @map("is_public")
  userSaved            Boolean         @default(false) @map("user_saved")
  isLegacy             Boolean         @default(false) @map("is_legacy")
  savedBy              SavedCollection[]
  publicId             String          @unique @map("public_id")
  title                String
  description          String?
  originalBookingCode  String?         @map("original_booking_code")
  generationReport     Json?           @map("generation_report")
  instruction          String?
  createdAt            DateTime        @default(now()) @map("created_at")
  expiresAt            DateTime?       @map("expires_at")
  slips                GeneratedSlip[]
  jobs                 GenerationJob[]

  @@index([ownerId, createdAt])
  @@index([deleteAfter])
  @@index([lifecycleCheckedAt])
  @@index([userSaved, isPublic, createdAt])
  @@map("slip_groups")
}

model GeneratedSlip {
  id             String           @id @default(cuid())
  groupId        String           @map("group_id")
  group          SlipGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  bookingCode    String           @map("booking_code")
  shareUrl       String           @map("share_url")
  totalOdds      Float            @map("total_odds")
  confidence     Float
  riskLevel      VarianceLevel    @map("risk_level")
  selectionCount Int              @map("selection_count")
  fingerprint    String
  rankOrder      Int              @default(0) @map("rank_order")
  slipScore      Float            @default(0) @map("slip_score")
  playStatus     SlipPlayStatus   @default(UNKNOWN) @map("play_status")
  result         SettlementResult @default(UNKNOWN)
  playCheckedAt  DateTime?        @map("play_checked_at")
  openLegs       Int              @default(0) @map("open_legs")
  liveLegs       Int              @default(0) @map("live_legs")
  playedLegs     Int              @default(0) @map("played_legs")
  cutLegs        Int              @default(0) @map("cut_legs")
  cutSummary     String?          @map("cut_summary")
  expiresAt      DateTime?        @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  selections     SlipSelection[]

  @@index([groupId])
  @@index([groupId, rankOrder])
  @@index([bookingCode])
  @@index([fingerprint])
  @@index([playStatus])
  @@map("generated_slips")
}

model SlipSelection {
  matchPhase String @default("unknown") @map("match_phase")
  matchCheckedAt DateTime? @map("match_checked_at")
  id                    String        @id @default(cuid())
  slipId                String        @map("slip_id")
  slip                  GeneratedSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  sportyEventId         String        @map("sporty_event_id")
  marketId              String        @map("market_id")
  outcomeId             String        @map("outcome_id")
  specifier             String        @default("")
  homeTeam              String        @map("home_team")
  awayTeam              String        @map("away_team")
  league                String
  marketName            String        @map("market_name")
  selectionName         String        @map("selection_name")
  odds                  Float
  baseProbability       Float?        @map("base_probability")
  baseModelVersion      String?       @map("base_model_version")
  predictedAt           DateTime?     @map("predicted_at")
  predictionMode        String?       @map("prediction_mode")
  predictionProbability Float         @map("prediction_probability")
  predictionScore       Float         @map("prediction_score")
  modelVersion          String        @default("odds-v1") @map("model_version")
  kickoffAt             DateTime?     @map("kickoff_at")
  playStatus            LegPlayStatus @default(UNKNOWN) @map("play_status")
  result                SettlementResult @default(UNKNOWN)
  resultSource          String?       @map("result_source")
  resultCheckedAt       DateTime?     @map("result_checked_at")
  resultEvidence        Json?         @map("result_evidence")
  score                 String?
  playNote              String?       @map("play_note")

  @@index([slipId])
  @@index([playStatus])
  @@map("slip_selections")
}

model Prediction {
  id         String   @id @default(cuid())
  eventId    String   @map("event_id")
  market     String
  selection  String
  probability Float
  confidence Float
  modelVersion String @map("model_version")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventId, market, selection])
  @@map("predictions")
}

model GenerationJob {
  requestKey String? @unique @map("request_key")
  requestId String? @map("request_id")
  payloadHash String? @map("payload_hash")
  requestedCount Int @default(0) @map("requested_count")
  failures Json @default("[]")
  id        String    @id @default(cuid())
  groupId   String?   @map("group_id")
  group     SlipGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status    JobStatus @default(PENDING)
  progress  Int       @default(0)
  total     Int       @default(0)
  failedCount Int     @default(0) @map("failed_count")
  completedTasks String[] @default([]) @map("completed_tasks")
  error     String?
  stage     String   @default("QUEUED")
  stageDetail String? @map("stage_detail")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("generation_jobs")
}

enum BookingCodeStatus {
  PENDING
  ACTIVE
  PARTIAL
  INACTIVE
  EXPIRED
}

model BookingCode {
  id               String            @id @default(cuid())
  code             String            @unique
  source           String
  sourceUrl        String?           @map("source_url")
  firstSeenAt      DateTime          @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime          @default(now()) @map("last_seen_at")
  expiresAt        DateTime          @map("expires_at")
  upstreamExpiresAt DateTime?        @map("upstream_expires_at")
  checkedAt        DateTime?         @map("checked_at")
  status           BookingCodeStatus @default(PENDING)
  activeSelections Int               @default(0) @map("active_selections")
  totalSelections  Int               @default(0) @map("total_selections")
  snapshot         Json?
  lastError        String?           @map("last_error")
  lastUsedAt       DateTime?         @map("last_used_at")

  @@index([status, expiresAt])
  @@index([checkedAt])
  @@map("booking_codes")
}

model CodeSource {
  id            String   @id @default(cuid())
  url           String   @unique
  enabled       Boolean  @default(true)
  checkedAt     DateTime? @map("checked_at")
  lastError     String?   @map("last_error")
  discovered    Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("code_sources")
}

model CodeCrawlRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  discovered    Int       @default(0)
  verified      Int       @default(0)
  errors        Json?

  @@map("code_crawl_runs")
}

// Append-only provenance for dataset replay; no bookmaker credentials or account data.
model TrainingEvent {
  id            String   @id @default(cuid())
  eventKey      String?  @unique @map("event_key")
  groupId       String?  @map("group_id")
  jobId         String?  @map("job_id")
  profileId     String?  @map("profile_id")
  kind          String
  schemaVersion Int      @default(1) @map("schema_version")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([groupId, createdAt])
  @@index([jobId, createdAt])
  @@index([kind, createdAt])
  @@map("training_events")
}

model LearningProfile {
  id          String   @id
  preferences Json
  revision    Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("learning_profiles")
}

model TrainingFeedback {
  id              String   @id
  groupId         String   @map("group_id")
  profileId       String?  @map("profile_id")
  rating          String
  note            String?
  correctedPrompt String?  @map("corrected_prompt")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([groupId])
  @@map("training_feedback")
}


model AppUser {
  uiSettings Json? @map("ui_settings")
  id        String @id @default(uuid())
  publicId  String @unique @default(cuid()) @map("public_id")
  username  String?
  profileSyncedAt DateTime? @map("profile_synced_at")
  clerkId   String @unique @map("clerk_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  groups    SlipGroup[]
  saves     SavedCollection[]
  following CreatorFollow[] @relation("CreatorFollowing")
  followers CreatorFollow[] @relation("CreatorFollowers")
  @@map("app_users")
}

model CreatorFollow {
  followerId String @map("follower_id")
  creatorId String @map("creator_id")
  follower AppUser @relation("CreatorFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creator AppUser @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@id([followerId, creatorId])
  @@index([creatorId])
  @@map("creator_follows")
}

model SavedCollection {
  hiddenAt DateTime? @map("hidden_at")
  userId String @map("user_id")
  groupId String @map("group_id")
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  group SlipGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  @@id([userId, groupId])
  @@index([groupId])
  @@map("saved_collections")
}

// Independent of collection retention; forecast fields are immutable, result evidence may be corrected.
model PredictionObservation {
  id               String   @id
  slipId           String   @map("slip_id")
  ticketSize       Int      @map("ticket_size")
  eventId          String   @map("event_id")
  marketId         String   @map("market_id")
  outcomeId        String   @map("outcome_id")
  specifier        String
  marketName       String   @map("market_name")
  league           String
  mode             String?
  odds             Float
  probability      Float
  baseProbability  Float    @map("base_probability")
  modelVersion     String   @map("model_version")
  baseModelVersion String   @map("base_model_version")
  predictedAt      DateTime @map("predicted_at")
  kickoffAt        DateTime @map("kickoff_at")
  result           String
  resultSource     String?  @map("result_source")
  verified         Boolean  @default(false)
  resultKnownAt    DateTime @map("result_known_at")
  checkedAt        DateTime @map("checked_at")

  @@index([kickoffAt])
  @@index([modelVersion, kickoffAt])
  @@map("prediction_observations")
}
