# Production edge: Spaceship DNS A/AAAA → this host, then automatic HTTPS.
# Requires DOMAIN (and optional ACME_EMAIL) in the Compose environment.

{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip

	# Same-origin API so the browser never talks to :3001
	handle /api* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
