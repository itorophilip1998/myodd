{
  "name": "myodd",
  "version": "0.2.21",
  "private": true,
  "description": "myOdd — SportyBet booking code variations from odds-first scoring",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @myodd/api prisma:generate",
    "db:migrate": "pnpm --filter @myodd/api prisma:migrate",
    "db:push": "pnpm --filter @myodd/api prisma:push"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
